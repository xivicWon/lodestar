#!/bin/sh
# main 직접 푸시 차단 — 모든 변경은 이슈 브랜치 → PR 로만 main에 반영한다 (CLAUDE.md 규칙).
# 활성화: git config core.hooksPath .githooks   (클론 후 1회)
protected_branch="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected_branch" ]; then
    echo "" >&2
    echo "✋ main 직접 푸시가 금지되어 있습니다." >&2
    echo "   이슈 브랜치에서 작업하고 PR로 main에 반영하세요 (CLAUDE.md 작업 규칙)." >&2
    echo "" >&2
    exit 1
  fi
done

exit 0
