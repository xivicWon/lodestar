{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodestar.local/schemas/manifest.v0.schema.json",
  "title": "Lodestar M0 Gold Set v0 — 매니페스트",
  "description": "고정(pinning)의 정본. 이 파일이 검사받지 않으면 '무엇을 고정했는가' 자체가 오타 하나로 사라질 수 있다 — `pinedSources` 같은 오타는 목록을 통째로 비우고, 그래도 '고정했다' 고 읽힌다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goldSetVersion",
    "issue",
    "status",
    "sourceRevision",
    "docsRevision",
    "note",
    "pinnedSources",
    "goldFiles",
    "fixtures",
    "fixtureHash",
    "goldSetId",
    "expectedCounts",
    "probeAxis"
  ],
  "properties": {
    "goldSetVersion": {
      "const": "gold-set/v0"
    },
    "issue": {
      "const": 99
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "note"
      ],
      "description": "승인 게이트. **자유 문장이 아니라 통제어휘여야 한다** — '승인됐는가' 를 기계로 읽을 수 없으면 I1 §1.2 의 게이트는 게이트가 아니라 권고문이다.",
      "properties": {
        "state": {
          "enum": [
            "DRAFT",
            "APPROVED"
          ],
          "description": "DRAFT 인 동안 이 gold 로 산출한 수치는 baseline 으로 인용할 수 없고, #88 착수 게이트(I1 G2)도 열리지 않는다."
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string",
          "pattern": "^@[A-Za-z0-9-]+$"
        },
        "approvedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "description": "EVL 계약 §2.7 과 같은 축소 RFC 3339 프로파일(대문자 T·Z 만). 정규식은 자릿수·범위까지만 막는다 — `2026-02-30` 은 통과하므로 **달력 유효성은 확인기가 직접 검사한다**(EVL 계약 §2.7 과 같은 정책)."
        }
      },
      "allOf": [
        {
          "description": "APPROVED 는 **누가 언제** 승인했는지 없이는 성립하지 않는다. 없으면 승인 사실이 파일에 남지 않은 것이고, 그건 승인이 아니다(본 계약 §7).",
          "if": {
            "properties": {
              "state": {
                "const": "APPROVED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "approvedBy",
              "approvedAt"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "approvedBy"
                  ]
                },
                {
                  "required": [
                    "approvedAt"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "sourceRevision": {
      "$ref": "#/$defs/rev"
    },
    "docsRevision": {
      "$ref": "#/$defs/rev"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "pinnedSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "path",
          "origin",
          "contentHash",
          "lines"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "repo",
              "fixture"
            ]
          },
          "revision": {
            "$ref": "#/$defs/rev"
          },
          "contentHash": {
            "$ref": "#/$defs/sha"
          },
          "lines": {
            "type": "integer",
            "minimum": 1
          },
          "axis": {
            "enum": [
              "source",
              "docs"
            ],
            "description": "이 원본이 속한 고정 축(§6). repo 원본은 필수다 — 축이 없으면 두 revision 중 아무 쪽이나 써도 통과해 제품 코드 기준선이 조용히 이동한다."
          }
        },
        "allOf": [
          {
            "description": "repo 원본은 revision 으로, 픽스처는 해시로 고정한다. 픽스처에 revision 을 달면 두 고정 축이 섞여 무엇이 정본인지 모호해진다.",
            "if": {
              "properties": {
                "origin": {
                  "const": "repo"
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "required": [
                "revision",
                "axis"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "revision"
                    ]
                  },
                  {
                    "required": [
                      "axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "description": "코드·DB·테스트 원본은 제품 축(source)에만 속한다. 계약 문서만 docs 축을 쓸 수 있다.",
            "if": {
              "properties": {
                "sourceId": {
                  "pattern": "^(code|db|test):"
                }
              },
              "required": [
                "sourceId"
              ]
            },
            "then": {
              "properties": {
                "axis": {
                  "const": "source"
                }
              }
            }
          }
        ]
      }
    },
    "goldFiles": {
      "$ref": "#/$defs/fileList"
    },
    "fixtures": {
      "$ref": "#/$defs/fileList"
    },
    "fixtureHash": {
      "$ref": "#/$defs/sha"
    },
    "goldSetId": {
      "type": "string",
      "pattern": "^gold-set/v0\\+[0-9a-f]{12}$"
    },
    "expectedCounts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "description": "파일별 총 항목 수의 고정값. 정답셋이 조용히 줄어드는 것을 막는다 — `--rehash` 는 이 값을 갱신하지 않으므로 축소는 반드시 손으로 적힌 편집이 된다."
    },
    "probeAxis": {
      "type": "object",
      "additionalProperties": false,
      "description": "L0 수집 입력 축(#125). 정답 축(sourceRevision)과 분리해 고정한다 — L0 프로브의 입력은 제품 코드 그 자체라 L0-fix 가 그 입력을 바꾸는데, 정답 축을 함께 옮기면 닫힌 범위의 L1 정답을 피검사 수집기로 다시 만들게 되어 gold 의 독립성이 깨진다.",
      "required": [
        "revision",
        "status",
        "note",
        "scopeRoots",
        "sources"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/rev"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "description": "이 축의 승인 게이트. 정답 축의 승인(status)과 별개다 — 축이 다르면 승인도 다르다. PROPOSED 인 동안 이 축으로 잰 실행은 기준선이 될 수 없다(verify_l0 V4).",
          "required": [
            "state",
            "note"
          ],
          "properties": {
            "state": {
              "enum": [
                "PROPOSED",
                "APPROVED"
              ],
              "description": "PROPOSED = 재고정 제안. 승인은 리뷰어(@xivicWon)의 몫이며 에이전트가 올릴 수 없다(I1 §7)."
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "approvedBy": {
              "type": "string",
              "pattern": "^@[A-Za-z0-9-]+$"
            },
            "approvedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "allOf": [
            {
              "description": "APPROVED 는 누가 언제 승인했는지 없이는 성립하지 않는다(정답 축과 같은 규칙).",
              "if": {
                "properties": {
                  "state": {
                    "const": "APPROVED"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "required": [
                  "approvedBy",
                  "approvedAt"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "approvedBy"
                      ]
                    },
                    {
                      "required": [
                        "approvedAt"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "scopeRoots": {
          "type": "array",
          "minItems": 1,
          "description": "이 축이 고정해야 하는 **범위**. 어느 pinnedSources 가 L0 입력인지를 코드가 아니라 데이터로 선언한다 — 선언이 없으면 sources 에서 항목을 하나 빼도 '원래 그만큼만 고정한다' 와 구분되지 않는다(G5.10 이 양방향으로 대조한다).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "track",
              "root"
            ],
            "properties": {
              "track": {
                "enum": [
                  "db",
                  "code"
                ]
              },
              "root": {
                "type": "string",
                "minLength": 1,
                "description": "repo 상대 경로 접두어. 파일 하나를 가리켜도 된다."
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "track",
              "path",
              "revision",
              "contentHash",
              "lines",
              "answerAxisSourceId",
              "sameAsAnswerAxis"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^probe:.+",
                "description": "입력 축 신원은 정답 축 sourceId 와 구분한다 — 같은 id 를 두 축이 쓰면 어느 축의 해시인지 모호해진다. 접두어만 있는 빈 식별자(`probe:`)는 아무것도 지목하지 못하므로 거부한다."
              },
              "track": {
                "enum": [
                  "db",
                  "code"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "$ref": "#/$defs/rev"
              },
              "contentHash": {
                "$ref": "#/$defs/sha"
              },
              "lines": {
                "type": "integer",
                "minimum": 1
              },
              "answerAxisSourceId": {
                "type": "string",
                "minLength": 1,
                "description": "같은 파일의 정답 축 sourceId. 두 축의 대응을 명시해야 '같은 파일인데 내용이 다르다' 를 확인기가 볼 수 있다."
              },
              "sameAsAnswerAxis": {
                "type": "boolean",
                "description": "두 축의 contentHash 가 같은가. 파생값이며 확인기가 재계산해 대조한다(G5.8) — 손으로 적은 true 는 재고정의 영향 범위를 숨긴다."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rev": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fileList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha"
          }
        }
      }
    }
  }
}
